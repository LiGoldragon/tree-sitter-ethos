{
  "grammars": [
    {
      "name": "ethos",
      "camelcase": "Ethos",
      "scope": "source.ethos",
      "path": ".",
      "file-types": ["ethos"],
      "highlights": ["queries/highlights.scm"],
      "locals": ["queries/locals.scm"],
      "injection-regex": "ethos"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "Tree-sitter grammar and editor highlighting support for authored Ethos files",
    "authors": [
      {
        "name": "LiGoldragon"
      }
    ],
    "links": {
      "repository": "https://github.com/LiGoldragon/tree-sitter-ethos"
    }
  },
  "bindings": {
    "c": true,
    "node": true,
    "rust": true
  }
}
